{
  "version": 2,
  "artifact_level": "assembly",
  "deliverable_intent": "fit_check",
  "summary": "五件基础护轴壳、五个正面装饰嵌件和八个背面/盖板嵌件；蓝白半球为一体双色件。",
  "required_interfaces": [
    {
      "id": "phone_fit",
      "kind": "internal_fit",
      "description": "参考闭合117.8×84.1×11.3 mm，背半机厚5.2 mm，按本轮要求切掉铰链侧残留竖边，保留其余弹性扣边及相机、按键避空。未标注的机械细节为可调默认。 折叠外屏正视：左铰链边直且左角近直角，右侧两角圆滑，前背盖及内腔一致。 标记的四处开口触手边缘修圆；前后壳铰链侧各两角做小圆角。 开口上下折角圆弧稍加大，保留既有矩形避让范围。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "slider",
      "kind": "sliding_fit",
      "description": "前盖内侧双销加粗并匹配加宽长槽，保留原轴向行程；整面盖板防脱，铰链侧留护轴片进出口；打开直边并拢时自由段及滑尾收纳。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "back_bond",
      "kind": "adhesive_joint",
      "description": "护轴片固定端直接胶接背盖浅槽，前盖改为滑动收纳端。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "camera_guard_bond",
      "kind": "adhesive_joint",
      "description": "独立胶囊保护圈粘入背盖外侧浅凹座，略高于摄像头；凸高按4mm可调假设加0.5mm余高，需实测核验。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "open_edge_meeting",
      "kind": "internal_fit",
      "description": "打开两条直边名义零间隙并拢、无实体穿透，同时自由片及滑动尾片入前盖槽；胶端留背盖。实机连续驱动尚待验证。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "closed_hinge_wrap",
      "kind": "internal_fit",
      "description": "护轴片沿铰链方向接近整机宽，助手计算闭合包覆路径和展开料长，同时保留前盖完整收纳；实际机身/铰链外廓待测。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "front_decoration_seats",
      "kind": "adhesive_joint",
      "description": "右中向内三角、左上蓝白一体半球及三个等距小球均坐入浅座；下部胶囊浅槽不贯穿。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "inner_decoration_seats",
      "kind": "adhesive_joint",
      "description": "内侧八个装饰浅定位槽全部位于整面护轴片盖板；黑长块、蓝十格块、两短条、白双格、小圆饼及下方双黑块完整嵌入盖板，不跨前盖分件缝。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "full_retainer_step",
      "kind": "adhesive_joint",
      "description": "略小于前盖同形轮廓的整面盖板，嵌入周边配套台阶并贴合；预留装配与胶接间隙和铰链出片口。",
      "source": "user_requested",
      "required": true
    }
  ],
