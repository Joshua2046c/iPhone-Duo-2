      "required": true
    },
    {
      "id": "camera_guard_bond",
      "kind": "adhesive_joint",
      "description": "独立胶囊保护圈粘入背盖外侧浅凹座，略高于摄像头；凸高按4mm可调假设加0.5mm余高，需实测核验。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "open_edge_meeting",
      "kind": "internal_fit",
      "description": "打开两条直边名义零间隙并拢、无实体穿透，同时自由片及滑动尾片入前盖槽；胶端留背盖。实机连续驱动尚待验证。",
      "source": "user_requested",
      "required": true
    },
    {
