{
  "version": 2,
  "artifact_level": "assembly",
  "deliverable_intent": "fit_check",
  "summary": "五件基础护轴壳、五个正面装饰嵌件和八个背面/盖板嵌件；蓝白半球为一体双色件。 背壳底部有小型精灵球凹刻。",
  "required_interfaces": [
    {
      "id": "phone_fit",
      "kind": "internal_fit",
      "description": "按用户要求从转轴开口侧单侧缩减3.1 mm，前后盖与配套承载件同步缩减，内侧R角按手机图片轮廓拟合；保留按键通道和转轴出片口。此前84.1 mm手机宽为参考图值，缩减后的81 mm名义试配包络是派生默认，非实测认证。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "slider",
      "kind": "sliding_fit",
      "description": "前盖内侧双销加粗并匹配加宽长槽，保留原轴向行程；整面盖板防脱，铰链侧留护轴片进出口；打开直边并拢时自由段及滑尾收纳。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "back_bond",
      "kind": "adhesive_joint",
      "description": "护轴片固定端直接胶接背盖浅槽，前盖改为滑动收纳端。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "camera_guard_bond",
      "kind": "adhesive_joint",
      "description": "外孔和保护圈按参考玻璃的两端圆滑轮廓；贴机侧另开相对外孔大约等距外扩4 mm、深3.9 mm的避让空间，连续圆滑弧面衔接外孔；保护圈浅座配套胶接。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "open_edge_meeting",
      "kind": "internal_fit",
      "description": "打开两条直边名义零间隙并拢、无实体穿透，同时自由片及滑动尾片入前盖槽；胶端留背盖。实机连续驱动尚待验证。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "closed_hinge_wrap",
      "kind": "internal_fit",
      "description": "护轴片沿铰链方向接近整机宽，助手计算闭合包覆路径和展开料长，同时保留前盖完整收纳；实际机身/铰链外廓待测。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "front_decoration_seats",
      "kind": "adhesive_joint",
      "description": "右中向内三角、左上蓝白一体半球及三个等距小球均坐入浅座；下部胶囊浅槽不贯穿。 上部增加按蓝色标注走向的窄浅折线槽，拐点圆滑过渡。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "inner_decoration_seats",
      "kind": "adhesive_joint",
      "description": "内侧八个装饰浅定位槽全部位于整面护轴片盖板；黑长块、蓝十格块、两短条、白双格、小圆饼及下方双黑块完整嵌入盖板，不跨前盖分件缝。",
      "source": "user_requested",
      "required": true
    },
    {
      "id": "full_retainer_step",
      "kind": "adhesive_joint",
      "description": "略小于前盖同形轮廓的整面盖板，嵌入周边配套台阶并贴合；预留装配与胶接间隙和铰链出片口。",
      "source": "user_requested",
      "required": true
    }
  ],
